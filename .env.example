# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for ranking, question generation, and summarization
RECRUITER_MODEL=llama-3.3-70b-versatile

# Deterministic output for reproducible demos
RECRUITER_TEMPERATURE=0.1

# Where the ATS SQLite database lives
RECRUITER_DB_PATH=data/ats.db

# Strip PII before ranking. Turning this off is logged per candidate.
RECRUITER_REDACT_FOR_RANKING=true

# Company details used on calendar invites
RECRUITER_COMPANY_NAME=Mercurial Minds
RECRUITER_TIMEZONE=Asia/Karachi
